# RE:ENTRY runs in deterministic demo mode by default.
REENTRY_MODE=demo
REENTRY_CASE_ID=case-042
REENTRY_MAX_UPLOAD_BYTES=10485760
REENTRY_REQUEST_READ_TIMEOUT_SECONDS=30
# Absolute wall-clock limit for any parsed request, independent of chunk count.
REENTRY_REQUEST_MAX_DURATION_SECONDS=300
REENTRY_MAX_IN_FLIGHT_REQUESTS=32
REENTRY_MAX_IN_FLIGHT_BODY_BYTES=268435456
REENTRY_MAX_IN_FLIGHT_PLANS=8
REENTRY_MAX_LIVE_PLAN_RUNS=10
# Local-only escape hatch for exercising the live provider against synthetic
# data before a durable store exists. Keep false for every real deployment.
REENTRY_ALLOW_EPHEMERAL_STORE=false

# Set REENTRY_MODE=live only after configuring AWS credentials and a Bedrock
# model available in your account. Never commit credentials or .env files.
AWS_REGION=us-east-1
# Current geo inference profile; replace only after verifying model access in
# the selected region/account.
REENTRY_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Live mode defaults to verified evidence only. Set this only after a reviewed
# data-governance decision for the selected model and region.
REENTRY_LIVE_ALLOW_UNREVIEWED_DATA=false
# Common direct identifiers are redacted from provider text by default. Keep
# this disabled unless the deployment has an approved claimant-data policy.
REENTRY_LIVE_ALLOW_PII=false
REENTRY_ALLOWED_AWS_REGIONS=us-east-1
REENTRY_ALLOWED_MODEL_IDS=us.anthropic.claude-sonnet-4-5-20250929-v1:0
